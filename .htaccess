# Menonaktifkan directory listing
Options -Indexes

# Aktifkan mesin rewrite (wajib untuk clean URL)
RewriteEngine On

# ------------------------------------------------------------
# ROUTING CLEAN URL (berfungsi di subfolder & root hosting)
# .htaccess ini diletakkan di folder project, jadi semua path
# relatif terhadap folder project (portable).
# ------------------------------------------------------------

# 1. Root '/' -> halaman beranda landing
RewriteRule ^$ landing/index.php [L]

# 2. Slug halaman (/tentang, /program, /katalog, dst) -> landing/<slug>.php
#    Hanya slug huruf-kecil & tanda hubung; hindari file/folder nyata.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-z0-9-]+)$ landing/$1.php [L]

# 3. Blokir akses ke folder/file sensitif
RewriteRule ^(docs|@agents|Zzz|\.git|\.rtk|\.codebase-memory)(/|$) - [F,L]

<FilesMatch "\.(md|txt|log|json|env|sql)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Order Deny,Allow
  Deny from all
</FilesMatch>

# 4. Kompresi GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 5. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# 6. Cache untuk aset statis
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresDefault "access plus 2 days"
</IfModule>

<LimitExcept GET POST HEAD>
  Deny from all
</LimitExcept>
